<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Theme.NutriMove" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Your existing color overrides… -->
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- Splash theme, used only by your SplashActivity -->
    <style name="Theme.NutriMove.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Show your logo-centered drawable as the window background -->
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <!-- Hide the app bar during the splash -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

</resources>
